# Hostinger public_html template — Vue SPA + Laravel index.php co-located.
# Keep in sync with frontend/public/.htaccess (source of truth for SPA builds).

DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Pass auth headers through to PHP-FPM / CGI (Laravel Sanctum / API).
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Laravel API + Sanctum CSRF — must bypass the Vue SPA fallback.
    RewriteCond %{REQUEST_URI} ^/api/ [NC,OR]
    RewriteCond %{REQUEST_URI} ^/sanctum/ [NC]
    RewriteRule ^ index.php [L]

    # Existing files/directories — serve as-is; everything else → Vue SPA.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

# PWA metadata cache policy when SPA files are co-located in this public/ root.
# Full guidance: docs/08-deployment/PWA.md
<IfModule mod_headers.c>
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "^sw\.js$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Service-Worker-Allowed "/"
    </FilesMatch>
    <FilesMatch "^manifest\.webmanifest$">
        Header set Cache-Control "no-cache"
        Header set Content-Type "application/manifest+json; charset=utf-8"
    </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
    <IfModule mod_setenvif.c>
        SetEnvIf Request_URI "^/assets/" LONG_CACHE
        SetEnvIf Request_URI "^/icons/" LONG_CACHE
        Header set Cache-Control "public, max-age=31536000, immutable" env=LONG_CACHE
    </IfModule>
</IfModule>
